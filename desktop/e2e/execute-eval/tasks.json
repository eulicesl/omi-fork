        "context": {
          "source_app": "Telegram",
          "window_title": "Chat with Daniel",
          "detail": "Send Daniel the bullet summary of yesterday's standup on Telegram",
          "reasoning": "Promoted from staged tasks (priority=high, source=conversation)"
        }
      },
      "ground_truth": {
        "platform": "telegram",
        "recipient": "Daniel",
        "expected_substring": "standup"
      }
    },
