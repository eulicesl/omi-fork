# Copy to graders/.env and fill in.
# .env is gitignored.

# Telegram — Bot Token + the account/chat ID(s) used in the eval set.
# Get the bot token from @BotFather. The bot must be a member of every chat
# you grade against.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DANIEL=
TELEGRAM_CHAT_ID_SARAH=
TELEGRAM_CHAT_ID_MOM=

# Slack — User OAuth token with channels:history, im:history, groups:history.
SLACK_USER_TOKEN=
SLACK_CHANNEL_DESIGN=
SLACK_CHANNEL_ALEX_DM=

# Gmail — OAuth refresh token + client creds for the eval inbox.
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Google Calendar — same OAuth as Gmail typically works.
GCAL_CALENDAR_ID_WORK=
GCAL_CALENDAR_ID_PERSONAL=

# iMessage — graders/messages.py reads ~/Library/Messages/chat.db locally.
# No env required, but Full Disk Access must be granted to the terminal.
